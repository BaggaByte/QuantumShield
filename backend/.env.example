# ==============================================================================
# QuantumShield Backend - Environment Variables
# ==============================================================================
HOST=0.0.0.0
PORT=8001
DEBUG=false

# Comma-separated list of allowed frontend origins, or '*' for public relay
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Room and rate limit configurations
MAX_ROOMS=100
MAX_PARTICIPANTS_PER_ROOM=8
MAX_MESSAGE_SIZE_BYTES=65536
ROOM_TTL_SECONDS=3600
UNJOINED_ROOM_TTL_SECONDS=300
RATE_LIMIT_ROOMS_PER_MIN=15

# VAPID Private Key (PEM format string or loaded from vapid_private.pem)
# VAPID_PRIVATE_PEM=
