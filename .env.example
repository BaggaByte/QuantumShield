# ==============================================================================
# QuantumShield - Production & Deployment Environment Variables
# ==============================================================================

# Backend Relay Service
HOST=0.0.0.0
PORT=8001
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Frontend Live Deployment (e.g. Vercel, Docker Compose, or Static Hosting)
# Leave empty for local Docker Compose reverse proxy.
# For remote backend targets:
# VITE_BACKEND_URL=https://quantumshield-api.onrender.com
# VITE_WS_URL=wss://quantumshield-api.onrender.com
VITE_BACKEND_URL=
VITE_WS_URL=
