# ==============================================================================
# QuantumShield Frontend - Production & Staging Environment Variables
# ==============================================================================
#
# When running locally with Vite (`npm run dev`) or via Docker Compose,
# you can leave these variables empty. The frontend automatically falls back
# to the local backend relay at http://localhost:8001 / ws://localhost:8001.
#
# For Live Vercel / Cloud Deployments (e.g., Render, Railway, AWS, Fly.io):
# Set these variables in your Vercel Project Settings > Environment Variables:
#
# 1. VITE_BACKEND_URL:
#    The HTTPS URL of your FastAPI backend relay.
#    Example: https://quantumshield-api.onrender.com
#
# 2. VITE_WS_URL:
#    The WSS (Secure WebSocket) URL of your FastAPI backend relay.
#    Example: wss://quantumshield-api.onrender.com
#
VITE_BACKEND_URL=
VITE_WS_URL=
